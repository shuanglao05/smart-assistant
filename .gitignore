# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.db
*.sqlite3
# SQLite WAL 模式的运行时文件（随数据库自动生成，不要入库）
*.db-shm
*.db-wal
# 数据库备份（清理/迁移前的手工快照，不入库）
*.db.bak*
*.db.bak-*

# 运行时日志
*.log

# 运行时数据目录（数据库 / 上传文件 / 缓存统一在这里，不入库）
backend/data/

# 旧路径（迁移前的残留目录，保留以防误提交）
backend/uploads/
backend/.cache/

# 环境变量（真实密钥，绝不入库）
.env
.env.*
!.env.example

# Node
node_modules/
dist/
.vite/
# Vite 构建时生成的临时配置文件（vite build 会产生，非源码）
vite.config.ts.timestamp-*.mjs

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
