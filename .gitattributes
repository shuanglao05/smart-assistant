# 统一换行符，避免 Windows(CRLF) / Linux(LF) 混用造成整文件 diff
* text=auto eol=lf

# 明确按文本处理
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf

# Windows 批处理必须保持 CRLF，否则无法执行
*.bat text eol=crlf

# 二进制文件，禁止任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.db   binary
*.pdf  binary
