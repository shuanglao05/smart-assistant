# ==========================================================
# 复制这份文件为 .env 后按需修改（.env 不入库）
#   cp .env.example .env
# ==========================================================

# ---------- 大模型 Provider ----------
# ollama = 本地 Ollama（默认，无需 API Key）
# cloud  = 云端 OpenAI 兼容平台（阿里云百炼 / DeepSeek / 智谱 / 硅基流动 / OpenAI 官方）
LLM_PROVIDER=ollama

# ---- 本地 Ollama（LLM_PROVIDER=ollama 时生效）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b          # 工具调不准可换 qwen3:14b；机器慢可换 qwen3:4b
OLLAMA_THINK=false             # false = 关闭思考，响应速度提升 3~5 倍
OLLAMA_NUM_CTX=8192            # 上下文窗口，默认 40960 太吃内存

# ---- 云端（LLM_PROVIDER=cloud 时生效）----
CLOUD_API_KEY=
CLOUD_BASE_URL=                # 留空 = OpenAI 官方
                               # 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
                               # 智谱：https://open.bigmodel.cn/api/paas/v4/
                               # DeepSeek：https://api.deepseek.com
                               # 硅基流动：https://api.siliconflow.cn/v1
CLOUD_MODEL=qwen-plus
# 多模态（图片识别 / 课表截图导入）用的视觉模型，必须是支持图片输入的模型
VISION_MODEL=qwen3-vl-plus
# 前端「切换模型」下拉里可选的云端模型清单（逗号分隔，可自己增删）
# 注意：名字要和你的 base_url 对应平台一致（同一个模型，不同平台叫法可能不同）
CLOUD_MODELS=qwen3.8-max,qwen-max,qwen-plus,qwen-flash,deepseek-v4-pro,deepseek-v3.2,glm-5.2,kimi-k3,qwen3-coder-plus,qwen3-vl-plus

# ---- 云端「深度思考」开关（仅阿里云百炼 / Qwen 思考型模型有效）----
# false = 关闭思考，首字响应快得多（默认）；true = 先推理再回答，更透彻但明显更慢
# 界面里也能改：设置 → API 管理 → 深度思考
CLOUD_ENABLE_THINKING=false
# 思考模式下的思维链上限（token）。0 = 用平台默认（约 4000）；仅开启思考时生效
CLOUD_THINKING_BUDGET=0

# ---- 云端网络（决定是「秒回」还是「等一两分钟」，重要）----
# 本机若装了代理软件（Clash / v2ray 等）、且直连云端平台很慢（TLS 握手 30~46 秒），
# 就在这里显式填写代理地址。留空 = 跟随环境变量 HTTP(S)_PROXY；两者都没有则直连。
#   · 代理软件端口经常变化，且未必写入系统环境变量；
#   · 界面里可一键扫描：设置 → API 管理 → 代理地址 → 自动检测。
CLOUD_PROXY_URL=
# true = 强制绕过代理直连。仅当代理会缓冲流式响应、导致打字机一顿一顿时才需要。
CLOUD_TRUST_ENV=false

# ---------- RAG 知识库（Embedding + 检索）----------
# 让助理能「翻着你上传的资料」回答；需先执行 ollama pull bge-m3
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
RAG_CHUNK_SIZE=500           # 每个知识片段的目标字符数
RAG_CHUNK_OVERLAP=80         # 相邻片段重叠字符数（避免句子被硬切断）
RAG_TOP_K=4                  # 全局默认检索片段数（Top-K）
RAG_EMBED_BATCH=32           # 向量化批大小：一次发给 Ollama 的片段数（长文档分批，一次发太多会超时）
RAG_MAX_TOTAL_CHUNKS=30      # 单次检索返回片段的总上限（多知识库合并后，防止撑爆上下文）
# 提示：Top-K 支持「按知识库」单独设置 —— 知识库页 → 顶部「当前库 Top-K」；
#       未单独设置的库使用上面的 RAG_TOP_K（规范库建议 2~3 求精准，资料库建议 8~10 求召回）。

# ---------- 文件上传 / 解析 ----------
MAX_UPLOAD_MB=50             # 单个上传文件大小上限（MB）。支持 PDF / Word(.docx) / 文本 / 图片
MAX_CONTENT_CHARS=500000     # 抽取正文的最大字符数（同时决定入库索引的文本量）

# ---------- JWT ----------
# 部署到公网前务必改成随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=please-change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./app.db

# ---------- 工具：天气（可选）----------
# 高德（推荐：支持中文城市名、国内访问快，个人认证有免费额度）
#   申请：https://console.amap.com/dev/key/app
AMAP_API_KEY=
# 备用：OpenWeatherMap（英文城市名检索）
#   申请：https://home.openweathermap.org/api_keys   注意：新 Key 需 10 分钟~2 小时生效，城市名用英文
OPENWEATHERMAP_API_KEY=

# ---------- 外部数据：节假日（无需配置）----------
# 日历的「放假 / 调休补班」数据来自 timor.tech 免费接口，无需 Key；
# 首次访问某年会拉取一次并缓存到 backend/.cache/（7 天后自动刷新）。
