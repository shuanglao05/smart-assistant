# ==========================================================
# 复制这份文件为 .env 后按需修改（.env 不入库）
#   cp .env.example .env
# ==========================================================

# ---------- 大模型 Provider ----------
# ollama = 本地 Ollama（默认，无需 API Key）
# cloud  = 云端 OpenAI 兼容平台（阿里云百炼 / DeepSeek / 智谱 / 硅基流动 / OpenAI 官方）
LLM_PROVIDER=ollama

# ---- 本地 Ollama（LLM_PROVIDER=ollama 时生效）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b          # 工具调不准可换 qwen3:14b；机器慢可换 qwen3:4b
OLLAMA_THINK=false             # false = 关闭思考，响应速度提升 3~5 倍
OLLAMA_NUM_CTX=8192            # 上下文窗口，默认 40960 太吃内存

# ---- 云端（LLM_PROVIDER=cloud 时生效）----
CLOUD_API_KEY=
CLOUD_BASE_URL=                # 留空 = OpenAI 官方
                               # 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
                               # 智谱：https://open.bigmodel.cn/api/paas/v4/
                               # DeepSeek：https://api.deepseek.com
                               # 硅基流动：https://api.siliconflow.cn/v1
CLOUD_MODEL=qwen-plus
# 前端「切换模型」下拉里可选的云端模型清单（逗号分隔，可自己增删）
# 注意：名字要和你的 base_url 对应平台一致（同一个模型，不同平台叫法可能不同）
CLOUD_MODELS=qwen3.8-max,qwen-max,qwen-plus,qwen-flash,deepseek-v4-pro,deepseek-v3.2,glm-5.2,kimi-k3,qwen3-coder-plus,qwen3-vl-plus

# ---------- RAG 知识库（Embedding + 检索）----------
# 让助理能「翻着你上传的资料」回答；需先执行 ollama pull bge-m3
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
RAG_CHUNK_SIZE=500           # 每个知识片段的目标字符数
RAG_CHUNK_OVERLAP=80         # 相邻片段重叠字符数（避免句子被硬切断）
RAG_TOP_K=4                  # 每次检索返回的片段数

# ---------- JWT ----------
SECRET_KEY=please-change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./app.db

# ---------- 工具：天气（可选）----------
# 高德（推荐：支持中文城市名、国内访问快，个人认证有免费额度）
#   申请：https://console.amap.com/dev/key/app
AMAP_API_KEY=
# 备用：OpenWeatherMap（英文城市名检索）
#   申请：https://home.openweathermap.org/api_keys   注意：新 Key 需 10 分钟~2 小时生效，城市名用英文
OPENWEATHERMAP_API_KEY=
