# ==========================================================
# 复制这份文件为 .env 后按需修改（.env 不入库）
#   cp .env.example .env
# ==========================================================

# ---------- 大模型 Provider ----------
# ollama = 本地 Ollama（默认，无需 API Key）
# cloud  = 云端 OpenAI 兼容平台（智谱 / DeepSeek / 硅基流动 / OpenAI 官方）
LLM_PROVIDER=ollama

# ---- 本地 Ollama（LLM_PROVIDER=ollama 时生效）----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b          # 工具调不准可换 qwen3:14b；机器慢可换 qwen3:4b
OLLAMA_THINK=false             # false = 关闭思考，响应速度提升 3~5 倍
OLLAMA_NUM_CTX=8192            # 上下文窗口，默认 40960 太吃内存

# ---- 云端（LLM_PROVIDER=cloud 时生效）----
CLOUD_API_KEY=
CLOUD_BASE_URL=                # 留空 = OpenAI 官方
                               # 智谱：https://open.bigmodel.cn/api/paas/v4/
                               # DeepSeek：https://api.deepseek.com
                               # 硅基流动：https://api.siliconflow.cn/v1
CLOUD_MODEL=gpt-4o-mini

# ---------- Embedding（后期 RAG 用，当前仅占位）----------
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3

# ---------- JWT ----------
SECRET_KEY=please-change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./app.db

# ---------- 工具：天气（可选）----------
# 申请：https://home.openweathermap.org/api_keys   注意：新 Key 需 10 分钟~2 小时生效，城市名用英文
OPENWEATHERMAP_API_KEY=
