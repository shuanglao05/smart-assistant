# ============================================================================
# IPAS 智能个人助理 · 环境配置模板（.env.example）
# ----------------------------------------------------------------------------
# 使用方法：
#   1) 复制本文件为 .env：   cp .env.example .env   （Windows: copy .env.example .env）
#   2) 按需修改下面的配置项
#   3) 【重要】.env 含真实密钥，已在 .gitignore 里被忽略，切勿提交到 Git
#
# ⚠️⚠️ 语法铁律：python-dotenv 【不支持行内注释】！
#     写成  CLOUD_MODEL=qwen-plus   # 说明
#     会把「# 说明」整段当成值（CLOUD_MODEL 就变成了 "# 说明"，导致配置错误）。
#     所以本文件的所有注释都【独占一行】，写在配置项的上方。请照此书写。
#
# 配置共 8 块：
#   1) 大模型提供方（本地 / 云端二选一）
#   2) 本地 Ollama
#   3) 云端 API（多平台，推荐在界面「设置 → API」里管理）
#   4) RAG 知识库（向量检索）
#   5) 文件上传与解析
#   6) 数据存储位置（数据库 / 上传文件 / 缓存）
#   7) 安全（JWT 密钥）
#   8) 工具类（天气、节假日）
# ============================================================================


# ============================ 1. 大模型提供方 ================================
# ollama = 本地 Ollama（默认，无需 API Key、不花钱、数据不出本机）
# cloud  = 云端 OpenAI 兼容平台（阿里云百炼 / 智谱 / DeepSeek / 硅基流动 / OpenAI 等）
# 说明：这只决定「默认」用哪个；界面上随时可切换，且云端支持同时接入多个平台。
LLM_PROVIDER=ollama


# ============================ 2. 本地 Ollama =================================
# 仅当 LLM_PROVIDER=ollama 时生效。需先安装 Ollama 并 pull 模型。
# 界面「设置 → API → 本地 Ollama」会自动发现本机所有已安装模型，可切换 / 删除。
OLLAMA_BASE_URL=http://localhost:11434

# 默认本地模型。工具调用不准可换 qwen3:14b；机器较慢可换 qwen3:4b
OLLAMA_MODEL=qwen3:8b

# 本地模型是否输出思考过程。false = 关闭思考，响应快 3~5 倍（推荐）
OLLAMA_THINK=false

# 上下文窗口（token）。默认 40960 太吃内存，按机器配置调整
OLLAMA_NUM_CTX=8192


# ============================ 3. 云端 API ====================================
# 【推荐做法】多平台 API 请在界面「设置 → API → 接入新 API」里添加，
#             它们保存在数据库（llm_providers 表），可同时接入多个、聊天里自由切换。
#             下面这组 CLOUD_* 是「单平台兜底配置」，一般留空即可。
#
# 各平台 base_url（注意：填 OpenAI 兼容端点，不是原生端点）：
#   智谱：      https://open.bigmodel.cn/api/paas/v4
#   阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
#               （应用专属域名形如 https://ws-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1）
#   DeepSeek：  https://api.deepseek.com/v1
#   硅基流动：  https://api.siliconflow.cn/v1
#   OpenAI：    https://api.openai.com/v1
# 鉴权：统一为请求头 Authorization: Bearer <你的 API Key>
# 注意：阿里云百炼的 OpenAI 兼容端点不提供 /models 模型列表接口，模型名需手动填写。

# 云端 API 密钥（留空 = 用界面里接入的 provider）
CLOUD_API_KEY=

# 云端 API 端点（留空 = 用界面里接入的 provider）
CLOUD_BASE_URL=

# 云端默认模型
CLOUD_MODEL=qwen-plus

# 多模态（图片识别 / 课表截图导入）用的视觉模型，必须是支持图片输入的模型
VISION_MODEL=qwen3-vl-plus

# 前端「切换模型」下拉里可选的云端模型清单（逗号分隔，可增删）
# 注意：模型名要与 base_url 对应平台一致（同一模型在不同平台叫法可能不同）
CLOUD_MODELS=qwen3.8-max,qwen-max,qwen-plus,qwen-flash,deepseek-v4-pro,deepseek-v3.2,glm-5.2,kimi-k3,qwen3-coder-plus,qwen3-vl-plus

# ---- 深度思考开关（对推理型模型有效）----
# 仅对支持思考的模型有意义（阿里云百炼 qwen3 系列、智谱 GLM-5.x、DeepSeek reasoner 等）。
# false = 关闭思考，首字响应快得多（默认）；true = 先推理再回答，更透彻但明显更慢。
# 界面里也能改：设置 → API 管理 → 深度思考
CLOUD_ENABLE_THINKING=false

# 思考模式下的思维链长度上限（token）。0 = 用平台默认（约 4000）；仅开启思考时生效
CLOUD_THINKING_BUDGET=0

# ---- 云端网络（决定「秒回」还是「等一两分钟」，非常重要）----
# 若本机装了代理软件（Clash / v2ray 等），且直连云端平台很慢（TLS 握手 30~46 秒），
# 就在这里显式填代理地址，例如 http://127.0.0.1:7890。
# 留空 = 跟随系统环境变量 HTTP(S)_PROXY；两者都没有则直连。
# 提示：代理软件端口常变，界面里可一键扫描：设置 → API 管理 → 代理地址 → 自动检测。
CLOUD_PROXY_URL=

# true = 强制绕过代理直连。仅当代理会缓冲流式响应、导致打字机一顿一顿时才需要开启
CLOUD_TRUST_ENV=false


# ============================ 4. RAG 知识库 ==================================
# 让助理能「翻着你上传的资料」回答。需先执行：ollama pull bge-m3
# 向量化用本地 Ollama，零成本，与对话大模型完全独立。
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3

# 每个知识片段的目标字符数（按「语义单元」合并凑满，不会在句子中间断开）
RAG_CHUNK_SIZE=500

# 相邻片段的重叠字符数（回退的是完整句子，不会切断上一句）
RAG_CHUNK_OVERLAP=80

# 全局默认检索片段数（Top-K）。支持「按知识库」单独设置（知识库页 → 当前库 Top-K）
RAG_TOP_K=4

# 向量化批大小：一次发给 Ollama 的片段数（长文档必须分批，一次发太多会超时）
RAG_EMBED_BATCH=32

# 单次检索返回片段的总上限（多个知识库合并后使用，防止撑爆上下文）
RAG_MAX_TOTAL_CHUNKS=30


# ============================ 5. 文件上传与解析 ==============================
# 单个上传文件大小上限（MB）。支持 PDF / Word(.docx) / 文本 / 代码 / 图片
MAX_UPLOAD_MB=50

# 抽取正文的最大字符数（同时决定入库索引的文本量）
MAX_CONTENT_CHARS=500000


# ============================ 6. 数据存储位置 ================================
# 所有运行时数据都放在数据目录下：
#   <数据目录>/app.db       SQLite 数据库
#   <数据目录>/uploads/     用户上传的文件
#   <数据目录>/cache/       磁盘缓存（节假日等，可随时删）
#
# DATA_DIR 留空 = 默认 backend/data/。
# 也可以在界面上修改：设置 → 账户 → 数据存储位置（改完需重启后端）。
# 若手动指定，请填写绝对路径，例如：D:/ipas-data
DATA_DIR=

# 数据库连接串。留空 = 自动使用 <数据目录>/app.db（推荐，无需填写）
DATABASE_URL=


# ============================ 7. 安全 ========================================
# JWT 签名密钥。【部署到公网前务必改成随机串】：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=please-change-me-to-a-random-string

# 登录态有效期（分钟）。1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ============================ 8. 工具类数据源 ================================
# ---- 天气（可选；不配则天气功能不可用，其余功能不受影响）----
# 高德地图（推荐：支持中文城市名、国内访问快，个人认证有免费额度）
#   申请：https://console.amap.com/dev/key/app
AMAP_API_KEY=

# 备用：OpenWeatherMap（用英文城市名检索）
#   申请：https://home.openweathermap.org/api_keys
#   注意：新申请的 Key 需 10 分钟~2 小时才生效
OPENWEATHERMAP_API_KEY=

# ---- 节假日（无需配置）----
# 日历的「放假 / 调休补班」数据来自 timor.tech 免费接口，无需 Key，
# 首次访问某年会自动拉取并缓存到 <数据目录>/cache/（7 天后自动刷新）。
